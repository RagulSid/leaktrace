# Copy to .env and fill in. Never commit .env.
# 127.0.0.1 rather than localhost: localhost may try IPv6 first and wait for the connect timeout.
FALKORDB_HOST=127.0.0.1
# FALKORDB_CONNECT_TIMEOUT_S=3
# 6380, not 6379: a native Redis on a dev machine often holds 6379 and would shadow FalkorDB.
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3000
# FALKORDB_PASSWORD=
# Tenant whose graph the public "How it works" page reads.
LEAKTRACE_DEMO_TENANT=demo
# Signs login tokens. Set a long random value; without it tokens stop working when the server restarts.
LEAKTRACE_SECRET=
# Password for the synthetic demo accounts created by `python -m app.cli bootstrap` (random if unset).
LEAKTRACE_DEMO_PASSWORD=
# LEAKTRACE_TOKEN_TTL_S=43200
# How long an approval stays valid (seconds) and how long a field crew lease lasts.
# LEAKTRACE_APPROVAL_TTL_S=1800
# LEAKTRACE_LEASE_S=60
# LEAKTRACE_READ_TIMEOUT_MS=2000
# Optional: a language model for the helpers, through any OpenAI-compatible chat API. Leave empty to use the
# fixed rule-based chooser. Example base URL (Google AI Studio): https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LEAKTRACE_LLM_TIMEOUT_S=8
# Thinking models: "low" keeps Gemini Flash under the timeout (only sent when set).
# LEAKTRACE_LLM_REASONING_EFFORT=low
# LEAKTRACE_LLM_MAX_CALLS_PER_RUN=60
# Ask LeakTrace: who words answers (template | model | auto) and the passage vectors (hashed word counts, no model).
# LEAKTRACE_ASK_PHRASER=auto
# LEAKTRACE_EMBED_DIM=256
